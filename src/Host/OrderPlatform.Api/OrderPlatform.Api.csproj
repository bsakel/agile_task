<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP host for all modules: API conventions, security and the feature flag adapter (ADR-0011, ADR-0016, ADR-0019, ADR-0020). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Only the host references Microsoft.FeatureManagement; application code uses IFeatureFlags (ADR-0019). -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <!-- Runtime compilation of Wolverine handler code for development and tests; images use pre-generated code (ADR-0004). -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrderPlatform.Composition\OrderPlatform.Composition.csproj" />
  </ItemGroup>
</Project>
