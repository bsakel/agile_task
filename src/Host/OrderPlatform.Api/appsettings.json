{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "orderplatform-api" ]
      }
    }
  },
  "RateLimiting": {
    "Default": { "PermitLimit": 600, "WindowSeconds": 60 },
    "OrderSubmissionLimit": { "PermitLimit": 60, "WindowSeconds": 60 }
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "InProgressLease": "00:01:00",
    "CleanupSchedule": "0 3 * * *"
  },
  "Integrations": {
    "Inventory": { "Mode": "Http" },
    "Billing": {
      "Mode": "Http",
      "Http": { "BaseAddress": "https://billing.provider.invalid" }
    },
    "Shipping": { "Mode": "Http" }
  },
  "FeatureManagement": {
  }
}
