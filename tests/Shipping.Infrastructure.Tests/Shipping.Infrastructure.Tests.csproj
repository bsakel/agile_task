    <!-- Module test projects are named <Module>.<Layer>.Tests; assemblies and namespaces get the platform prefix. -->
    <AssemblyName>OrderPlatform.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>OrderPlatform.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Shipping\Shipping.Infrastructure\Shipping.Infrastructure.csproj" />
  </ItemGroup>
</Project>
